<!-- One dot per space: click to switch, drop a tab to move it there, drag a
     dot to reorder. Hidden while there is only one space. -->
<view>
  <Row if="{$spaces.length > 1}" justify="center" padding.top="4" padding.bottom="8">
    <Pressable for="space in $spaces" key="{space.id}" testID="space-{space.id}" tooltip="{space.name}" label="{space.name}"
               width="26" height="26" align="center" justify="center" cornerRadius="13"
               background="{space.isCurrent ? { material: 'glass' } : 'clear'}"
               animate="bouncy" hover:scale="1.3"
               dropTarget:scale="1.3" dropTarget:border.color="accent" dropTarget:border.width="2"
               onPress="spaces.activate(space.id)"
               draggable="{{ type: 'space', id: space.id }}"
               dropTypes="{['tab', 'space']}"
               onDrop="event.type === 'space' ? spaces.move(event.id, space.id) : tabs.move(event.id, { to: 'space', spaceId: space.id })">
      <Text if="{space.emoji}" fontSize="12">{space.emoji}</Text>
      <Stack else width="6" height="6" cornerRadius="3" background="{space.isCurrent ? 'accent' : 'secondary/0.4'}"/>
    </Pressable>
  </Row>
</view>
