<!-- One row of the vertical tab list: a 34pt pill, tinted glass when
     selected, close button on hover. No logic file: everything it does is a
     one-line action. Props: tab (TabInfo) -->
<view>
  <import name="menus" from="./tabMenu"/>
  <Pressable testID="tab-{tab.id}" anchorId="{tab.id}" group role="tab" label="{tab.title}" tooltip="{tab.title}"
             height="34" margin="2 6" padding.left="8" padding.right="4" gap="8" align="center" cornerRadius="8"
             background="{tab.isCurrent ? { material: 'glass', tint: 'accent/0.5' } : 'clear'}"
             dropTarget:border.color="accent" dropTarget:border.width="2"
             onPress="tabs.select(tab.id, { modifiers: event.modifiers })"
             draggable="{{ type: 'tab', id: tab.id }}"
             dropTypes="{['tab', 'url']}"
             onDrop="event.type === 'tab' ? tabs.move(event.id, { to: 'tabs', before: tab.id }) : tabs.create({ url: event.url, activate: false })">
    <contextMenu items="{menus.tabMenu(tab, $spaces)}"/>

    <TabIcon tabId="{tab.id}" size="16" opacity="{tab.isGhost || tab.isUnloaded ? 0.55 : 1}"/>
    <Column flex="1" align="start" gap="1">
      <Text fontSize="13" lineLimit="1" italic="{tab.hasCustomTitle}" opacity="{tab.isGhost || tab.isUnloaded ? 0.65 : 1}">{tab.title}</Text>
      <Text if="{tab.subtitle}" fontSize="10" color="secondary" lineLimit="1">{tab.subtitle}</Text>
    </Column>

    <!-- Accessories appear while the row is hovered. -->
    <Row gap="2" opacity="0" groupHover:opacity="1">
      <Pressable if="{tab.isSplit}" tooltip="Separate Split Tabs" padding="6" cornerRadius="99" color="secondary"
                 hover:background="primary/0.1" onPress="tabs.separateSplit(tab.id)">
        <Icon name="arrow.trianglehead.branch" size="9" weight="heavy"/>
      </Pressable>
      <Pressable testID="close-{tab.id}" tooltip="Close Tab" padding="6" cornerRadius="99" color="secondary"
                 hover:background="primary/0.1" onPress="tabs.close(tab.id)">
        <Icon name="xmark" size="9" weight="heavy"/>
      </Pressable>
    </Row>
  </Pressable>
</view>
